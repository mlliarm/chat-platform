OPENROUTER_API_KEY="<add your openrouter key here>"
DEFAULT_MODEL=openai/gpt-4o-mini
APP_URL=http://localhost:5000
APP_NAME=Local OpenRouter Chat

# Optional. FLASK_DEBUG=1 enables auto-reload and the Werkzeug debugger — that
# debugger is an interactive Python console on any traceback, so never turn it
# on for a server anything else can reach.
# FLASK_DEBUG=1

# Optional. Defaults to 127.0.0.1:5000. There is no auth or rate limiting, so
# only widen HOST behind something that authenticates.
# HOST=127.0.0.1
# PORT=5000
